{
  "info": {
    "name": "Kampüs API",
    "description": "Işıkhan IŞIK - 2416501044. Sprint 8 için altı istek. Test veritabanında npm run seed çalıştırın, ardından sunucuyu başlatıp istekleri sırayla çalıştırın. Seed mevcut etkinlikleri siler.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "1 Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sunucu ayakta ve öğrenci numarası doğru', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.student).to.eql('2416501044');",
              "  pm.expect(new Date(body.time).toISOString()).to.eql(body.time);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Etkinlik listesi",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Başlangıçta altı etkinlik var', function () {",
              "  pm.response.to.have.status(200);",
              "  const events = pm.response.json();",
              "  pm.expect(events).to.be.an('array').with.lengthOf(6);",
               "  events.forEach(function (event) {",
               "    pm.expect(event._id).to.match(/^[a-f0-9]{24}$/);",
               "    pm.expect(new Date(event.createdAt).toISOString()).to.eql(event.createdAt);",
               "    pm.expect(new Date(event.updatedAt).toISOString()).to.eql(event.updatedAt);",
               "  });",
               "  pm.collectionVariables.set('eventId', events[0]._id);",
              "  events.forEach(function (event) { pm.expect(event).not.to.have.property('image'); });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Tek etkinlik",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/events/{{eventId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
               "pm.test('Listedeki kayıt gerçek _id ile geliyor', function () {",
              "  pm.response.to.have.status(200);",
              "  const event = pm.response.json();",
               "  pm.expect(event._id).to.eql(pm.collectionVariables.get('eventId'));",
               "  pm.expect(event.title).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Olmayan etkinlik (404)",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/events/yok"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Olmayan etkinlik için 404 dönüyor', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json()).to.eql({ error: { message: 'Event not found' } });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Etkinlik oluştur (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kampüs İçin Mini API Atölyesi\",\n  \"category\": \"Atölye\",\n  \"date\": \"2026-12-08\",\n  \"time\": \"13:00\",\n  \"location\": \"Yazılım Kulübü Odası\",\n  \"description\": \"Birlikte küçük bir etkinlik API'si hazırlayacağız.\",\n  \"capacity\": 24\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://localhost:3000/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Yeni etkinlik 201 ve yeni kimlikle dönüyor', function () {",
              "  pm.response.to.have.status(201);",
              "  const event = pm.response.json();",
              "  const sent = JSON.parse(pm.request.body.raw);",
               "  pm.expect(event._id).to.match(/^[a-f0-9]{24}$/);",
               "  pm.expect(event._id).not.to.eql(pm.collectionVariables.get('eventId'));",
               "  pm.expect(new Date(event.createdAt).toISOString()).to.eql(event.createdAt);",
               "  pm.expect(new Date(event.updatedAt).toISOString()).to.eql(event.updatedAt);",
               "  pm.collectionVariables.set('createdEventId', event._id);",
              "  Object.keys(sent).forEach(function (key) { pm.expect(event[key]).to.eql(sent[key]); });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Eksik veri (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Eksik Bilgili Etkinlik\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://localhost:3000/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Eksik alanlar için 400 dönüyor', function () {",
              "  pm.response.to.have.status(400);",
               "  const message = pm.response.json().error.message;",
               "  pm.expect(message).to.include('date');",
               "  pm.expect(message).to.include('category');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
